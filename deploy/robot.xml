<mujoco model="grasping_robot">
    <compiler angle="radian" meshdir="meshes"/>
    <option timestep="0.002"/>
    <worldbody>
        <body name="base" pos="0 0 0">
            <geom name="base_geom" type="box" size="0.08 0.08 0.08"/>
            <body name="arm" pos="0 0 0.15">
                <joint name="arm_pan" type="hinge" axis="0 0 1" limited="false"/>
                <geom name="arm_geom" type="cylinder" size="0.04 0.15"/>
                <body name="forearm" pos="0 0 0.15">
                    <joint name="arm_lift" type="hinge" axis="0 1 0" limited="false"/>
                    <geom name="forearm_geom" type="cylinder" size="0.03 0.15"/>
                    <body name="end_effector" pos="0 0 0.2">
                        <body name="finger_left" pos="0 0.02 0">
                            <joint name="finger_left_joint" type="slide" axis="0 1 0" range="0 0.02" limited="true"/>
                            <geom name="finger_left_geom" type="box" size="0.01 0.02 0.05"/>
                        </body>
                        <body name="finger_right" pos="0 -0.02 0">
                            <joint name="finger_right_joint" type="slide" axis="0 -1 0" range="0 0.02" limited="true"/>
                            <geom name="finger_right_geom" type="box" size="0.01 0.02 0.05"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
    <actuator>
        <motor name="arm_pan_motor" joint="arm_pan"/>
        <motor name="arm_lift_motor" joint="arm_lift"/>
        <motor name="finger_left_motor" joint="finger_left_joint"/>
        <motor name="finger_right_motor" joint="finger_right_joint"/>
    </actuator>
</mujoco>